{
  "name": "gamebook-engine",
  "version": "0.1.0",
  "description": "Moteur de livre-jeu interactif (Gamebook Engine)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "ts-node-esm server/server.ts",
    "build": "tsc && vite build && node scripts/post-build.mjs && tsc -p tsconfig.server.json",
    "start": "STATIC_DIR=dist node dist-server/server.js",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.8",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/nodemailer": "^6.4.14",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^3.19.0",
    "jsdom": "^29.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.0",
    "dompurify": "^3.4.17",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "zod": "^3.24.4"
  }
}
