{
  "description": "ComfyUI workflow for gamebook image generation",
  "base_url": "http://127.0.0.1:8188",
  "model": "sd_xl_base_1.0.safetensors",
  "width": 800,
  "height": 1200,
  "steps": 25,
  "cfg_scale": 7,
  "sampler_name": "dpmpp_2m",
  "scheduler": "normal",
  "denoise": 1,
  "seed": 0,
  "prompt_template": "Illustration for gamebook. Scene: {scene}. Style: fantasy, detailed, atmospheric",
  "workflow": {
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 1123456789123456789,
        "steps": 25,
        "cfg": 7,
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "denoise": 1,
        "model": ["4", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["5", 0]
      }
    },
    "4": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "sd_xl_base_1.0.safetensors"
      }
    },
    "5": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 800,
        "height": 1200,
        "batch_size": 1
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": ["4", 1]
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": ["4", 1]
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["3", 0],
        "vae": ["4", 2]
      }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "ia_gen",
        "images": ["8", 0]
      }
    }
  }
}
